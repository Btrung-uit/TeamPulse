# Copy this file to .env and replace both placeholder secrets.
# .env is ignored by Git; this example contains no real credential.
MSSQL_SA_PASSWORD=ChangeMe_TeamPulse_2026!
MSSQL_PORT=1433
JWT_SIGNING_KEY=ReplaceWithAtLeast32RandomBytesBeforeRunning
APP_HOST=0.0.0.0
APP_PORT=8080

# Optional fixed-window limits.
AUTH_RATE_LIMIT=30
IMPORT_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECONDS=60

# Optional repository webhook. Generate a random secret with at least 32 UTF-8 bytes.
GITHUB_WEBHOOK_ENABLED=false
GITHUB_WEBHOOK_SECRET=ReplaceWithAtLeast32RandomBytesBeforeEnabling
