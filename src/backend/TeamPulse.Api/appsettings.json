{
  "Authentication": {
    "Jwt": {
      "Issuer": "TeamPulse.Api",
      "Audience": "TeamPulse.Web",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
