{
  "Authentication": {
    "Jwt": {
      "Issuer": "TeamPulse.Api",
      "Audience": "TeamPulse.Web",
      "AccessTokenMinutes": 15,
      "RefreshTokenDays": 7
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "WindowSeconds": 60,
    "Auth": {
      "PermitLimit": 30
    },
    "Import": {
      "PermitLimit": 10
    }
  },
  "Integrations": {
    "GitHub": {
      "Webhook": {
        "Enabled": false,
        "MaximumPayloadBytes": 2097152
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
